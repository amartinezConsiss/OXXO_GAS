<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_ic_logo_oxxo_gas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_logo_oxxo_gas"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ic_settings_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_settings"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/sales_component"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/top_container">

            <ImageView
                android:id="@+id/iv_top_cash_title"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/shape_green_border_top_box"
                app:layout_constraintEnd_toStartOf="@id/iv_top_cumulative_sale_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                style="@style/BlackBoldText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_cash"
                android:textAllCaps="true"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/iv_top_cash_title"
                app:layout_constraintEnd_toEndOf="@id/iv_top_cash_title"
                app:layout_constraintStart_toStartOf="@id/iv_top_cash_title"
                app:layout_constraintTop_toTopOf="@id/iv_top_cash_title" />

            <ImageView
                android:id="@+id/iv_bot_cash_information"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/shape_green_border_bot_box"
                app:layout_constraintEnd_toStartOf="@id/iv_top_cumulative_sale_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_top_cash_title" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="5dp"
                android:src="@drawable/ic_money_black"
                app:layout_constraintBottom_toBottomOf="@id/iv_bot_cash_information"
                app:layout_constraintStart_toStartOf="@id/iv_bot_cash_information"
                app:layout_constraintTop_toTopOf="@id/iv_bot_cash_information" />

            <TextView
                android:id="@+id/tv_cash_amount"
                style="@style/BlackBoldText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                tools:text="6,900.64"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="@id/iv_bot_cash_information"
                app:layout_constraintEnd_toStartOf="@id/tv_mxn_label" />

            <TextView
                android:id="@+id/tv_mxn_label"
                style="@style/BlackBoldText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                android:text="@string/mxn"
                app:layout_constraintBottom_toBottomOf="@id/iv_bot_cash_information"
                app:layout_constraintEnd_toEndOf="@id/iv_bot_cash_information" />

            <ImageView
                android:id="@+id/iv_top_cumulative_sale_title"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:background="@drawable/shape_green_border_top_box"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_top_cash_title"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                style="@style/BlackBoldText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cumulative_sale"
                android:textAllCaps="true"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/iv_top_cumulative_sale_title"
                app:layout_constraintEnd_toEndOf="@id/iv_top_cumulative_sale_title"
                app:layout_constraintStart_toStartOf="@id/iv_top_cumulative_sale_title"
                app:layout_constraintTop_toTopOf="@id/iv_top_cumulative_sale_title" />

            <ImageView
                android:id="@+id/iv_bot_cumulative_sale_info"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:background="@drawable/shape_green_border_bot_box"
                app:layout_constraintEnd_toEndOf="@id/iv_top_cumulative_sale_title"
                app:layout_constraintStart_toStartOf="@id/iv_top_cumulative_sale_title"
                app:layout_constraintTop_toBottomOf="@id/iv_top_cumulative_sale_title" />

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:layout_marginStart="5dp"
                android:src="@drawable/ic_drop"
                app:layout_constraintBottom_toBottomOf="@id/iv_bot_cumulative_sale_info"
                app:layout_constraintStart_toStartOf="@id/iv_bot_cumulative_sale_info"
                app:layout_constraintTop_toTopOf="@id/iv_bot_cumulative_sale_info" />

            <TextView
                android:id="@+id/tv_cumulative_sale"
                style="@style/BlackBoldText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                tools:text="808.99"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="@id/iv_bot_cumulative_sale_info"
                app:layout_constraintEnd_toStartOf="@id/tv_lts_label" />

            <TextView
                android:id="@+id/tv_lts_label"
                style="@style/BlackBoldText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                android:text="@string/lts"
                app:layout_constraintBottom_toBottomOf="@id/iv_bot_cumulative_sale_info"
                app:layout_constraintEnd_toEndOf="@id/iv_bot_cumulative_sale_info" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/sales_component"
            app:spanCount="2"
            tools:itemCount="6"
            tools:listitem="@layout/item_menu" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>