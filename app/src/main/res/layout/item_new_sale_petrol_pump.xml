<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pump"
    android:layout_width="match_parent"
    android:layout_height="175dp"
    android:layout_margin="5dp"
    android:background="@drawable/box_white">

    <ImageView
        android:id="@+id/iv_pump"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/img_gas_blue"
        app:layout_constraintBottom_toTopOf="@id/pump_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/pump_title"
        style="@style/BlackBoldText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pum_id"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@id/pump_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_pump"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/pump_status"
        style="@style/BlackText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pump_title"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Disponible" />

</androidx.constraintlayout.widget.ConstraintLayout>